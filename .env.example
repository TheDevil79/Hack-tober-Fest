# Server Configuration
PORT=5000
ALLOWED_ORIGINS=*

# Scanner Settings
SCAN_TIMEOUT_MS=10000
MAX_SCAN_CONCURRENCY=5
OSV_BASE_URL=https://api.osv.dev/v1/query

# Optional intelligence layer (scanner still works when these are unavailable)
MONGODB_URI=
MONGODB_DB=patchlens
MONGODB_TIMEOUT_MS=3000
# Use public DNS when an environment blocks Atlas SRV DNS lookups.
DNS_SERVERS=1.1.1.1,8.8.8.8

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
AI_PROVIDER=gemma
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_FALLBACK_MODELS=gemma-4-31b-it

VECTOR_INDEX=knowledge_vector_index
MAX_AI_CONCURRENCY=2

# Account authentication (MongoDB is required for sign-up)
# Optional legacy administrator account:
AUTH_USERNAME=
AUTH_PASSWORD=
# Use at least 32 random characters. Never commit the real value.
AUTH_SECRET=
AUTH_SESSION_TTL_SECONDS=28800
